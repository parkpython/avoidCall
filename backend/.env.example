APP_MODE=production
LOCAL_TEST_MODE=false
LOCAL_OUTBOUND_CALLS=false
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
DEEPGRAM_API_KEY=your_deepgram_api_key
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
SERVER_DOMAIN=your_public_backend_domain
ENVIRONMENT=production
ALLOWED_HOSTS=localhost,127.0.0.1,your_backend_host
CORS_ALLOWED_ORIGINS=
MAX_REQUEST_BODY_BYTES=65536
VERIFY_TWILIO_SIGNATURES=true
ALLOW_UNAUTHENTICATED_REQUESTS=false
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DEV_ADMIN_EMAIL=dev-admin@example.com
DEV_ADMIN_PASSWORD=change_me_to_a_long_random_password
DEV_ADMIN_NAME=Development Admin
DEV_ADMIN_PLAN_ID=starter
