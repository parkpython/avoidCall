APP_MODE=local
LOCAL_TEST_MODE=true
LOCAL_OUTBOUND_CALLS=false
ENVIRONMENT=development
SERVER_DOMAIN=localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
MAX_REQUEST_BODY_BYTES=65536
VERIFY_TWILIO_SIGNATURES=false
ALLOW_UNAUTHENTICATED_REQUESTS=true

# Local simulated calls do not require provider credentials.
# Voice preview still uses real OpenAI TTS; set this if you want preview audio.
# To place real Twilio calls from local mode:
# - set LOCAL_OUTBOUND_CALLS=true
# - expose this backend through a public HTTPS/WSS tunnel
# - set SERVER_DOMAIN to that public host, without https://
# - fill TWILIO_*, DEEPGRAM_API_KEY, OPENAI_API_KEY, and GROQ_API_KEY.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=your_openai_api_key_for_voice_preview
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
